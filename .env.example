DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Use either CLOUDINARY_URL or the three values below.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>

# Optional folder prefix inside Cloudinary.
CLOUDINARY_STORAGE_PREFIX=ecomcrm/media

# Groq Ask to AI assistant
GROQ_API_KEY=your-groq-api-key
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
